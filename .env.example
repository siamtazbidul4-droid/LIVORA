MONGODB_URI=
# Server & Security
NODE_ENV="development"
PORT="3000"
JWT_SECRET=
SESSION_SECRET=


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Notifications (Resend API)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="orders@novaracommerce.com"

# Payment Gateways (Bangladesh Official Merchant Gateways)
# Set the externally reachable HTTPS API and app URLs in production.
PUBLIC_API_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:5173"

# bKash Tokenized Checkout v2 (production: https://tokenized.pay.bka.sh/v2/tokenized-checkout)
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v2/tokenized-checkout"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# OAuth Authentication (Google & Facebook)
# Google GIS authorization-code flow: set the same web client ID in the browser and server.
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
# Facebook JavaScript SDK app ID is public; keep the app secret server-side only.
VITE_FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"
